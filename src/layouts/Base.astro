---
import "../styles/global.css";
import { type Lang, T, url } from "../i18n";
import { contacts, email, phone } from "../data/contact";

interface Props {
  title?: string; // bỏ trống = trang chủ
  lang: Lang;
  description?: string;
}

const { title, lang } = Astro.props;
const t = T(lang);
const description = Astro.props.description ?? "Product Designer, UI/UX";

const site = "OnTheShore";
const name = t("Ngưu (Roland) Nguyễn", "Nguu (Roland) Nguyen");
const fullTitle = title ? `${title} — ${site}` : `${name} — Product Designer, UI/UX`;
const path = Astro.url.pathname;
const bare = path.replace(/^\/vi(?=\/)/, ""); // đường dẫn không kèm /vi
const other: Lang = lang === "en" ? "vi" : "en";
// Umami Cloud (gói Hobby miễn phí). Website ID lấy trong cloud.umami.is → Settings → Websites.
const umamiId = "927cfeb3-1366-49b5-a686-c58d067f90e3";
const canonical = new URL(path, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

// Thông tin cho Google (schema.org Person).
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name,
  alternateName: ["Ngưu Nguyễn", "Roland Nguyen"],
  jobTitle: "Product Designer, UI/UX",
  url: Astro.site,
  image: new URL("/avatar.png", Astro.site),
  email: email.value,
  telephone: phone.href.slice(4),
  address: { "@type": "PostalAddress", addressLocality: "Nha Trang", addressCountry: "VN" },
  sameAs: contacts.filter((c) => c.href.startsWith("http")).map((c) => c.href),
};

// icon: path SVG 24x24, nét 1.5
const nav = [
  { href: "/", label: "Home", icon: "M4 11l8-7 8 7v9h-5v-6h-6v6H4z" },
  { href: "/about/", label: "About me", icon: "M12 12a4 4 0 100-8 4 4 0 000 8zM4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5" },
  { href: "/projects/", label: "Projects", icon: "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" },
  { href: "/products/", label: "Products", icon: "M12 3l8 4.5v9L12 21l-8-4.5v-9zM4 7.5l8 4.5 8-4.5M12 12v9" },
  { href: "/contact/", label: "Contact", icon: "M3 6h18v12H3zM3 6l9 7 9-7" },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={site} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "vi_VN"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#003c88" />
    <script is:inline>
      // Sáng/tối: lựa chọn đã lưu, không có thì sáng. Chạy trước khi vẽ để không nháy màu.
      // Màu thanh địa chỉ (theme-color) đổi theo, bất kể máy đang sáng hay tối.
      function setTheme(theme) {
        document.documentElement.dataset.theme = theme;
        for (const m of document.querySelectorAll('meta[name="theme-color"]')) m.content = theme === "dark" ? "#14284f" : "#003c88";
      }
      let saved;
      try { saved = localStorage.getItem("theme"); } catch {}
      setTheme(saved === "dark" ? "dark" : "light");
      // Vừa đổi ngôn ngữ (xem script cuối trang): bỏ hiệu ứng hiện dần để chỉ còn crossfade.
      try { if (sessionStorage.getItem("lang-keep")) document.documentElement.dataset.langSwitch = ""; } catch {}
    </script>
    <link rel="alternate" hreflang="vi" href={new URL(url("vi", bare), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(url("en", bare), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(url("en", bare), Astro.site)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {umamiId && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={umamiId} data-domains="ontheshore.biz" />}
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;1,400&family=Space+Grotesk:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="rail-l">
      <a class="mark" href={url(lang, "/")} aria-label="Ngưu Nguyễn">
        <img src="/avatar.png" alt="" width="96" height="96" />
        <span class="mark-name">Ngưu Nguyễn</span>
      </a>
      <div class="tools">
        <a class="lang" href={url(other, bare)} hreflang={other} lang={other} data-astro-prefetch="viewport">
          {
            // Cờ của ngôn ngữ sẽ chuyển sang, khớp với nhãn bên dưới.
            other === "en" ? (
              <svg class="flag" viewBox="0 0 30 20" aria-hidden="true"><rect width="30" height="20" fill="#b22234" /><path fill="#fff" d="M0 1.54h30v1.54H0zM0 4.62h30v1.54H0zM0 7.69h30v1.54H0zM0 10.77h30v1.54H0zM0 13.85h30v1.54H0zM0 16.92h30v1.54H0z" /><rect width="12" height="10.77" fill="#3c3b6e" /><path fill="#fff" d="M1.00 1.08m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M3.00 1.08m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M5.00 1.08m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M7.00 1.08m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M9.00 1.08m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M11.00 1.08m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M2.00 2.15m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M4.00 2.15m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M6.00 2.15m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M8.00 2.15m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M10.00 2.15m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M1.00 3.23m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M3.00 3.23m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M5.00 3.23m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M7.00 3.23m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M9.00 3.23m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M11.00 3.23m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M2.00 4.31m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M4.00 4.31m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M6.00 4.31m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M8.00 4.31m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M10.00 4.31m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M1.00 5.38m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M3.00 5.38m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M5.00 5.38m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M7.00 5.38m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M9.00 5.38m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M11.00 5.38m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M2.00 6.46m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M4.00 6.46m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M6.00 6.46m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M8.00 6.46m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M10.00 6.46m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M1.00 7.54m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M3.00 7.54m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M5.00 7.54m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M7.00 7.54m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M9.00 7.54m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M11.00 7.54m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M2.00 8.62m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M4.00 8.62m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M6.00 8.62m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M8.00 8.62m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M10.00 8.62m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M1.00 9.69m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M3.00 9.69m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M5.00 9.69m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M7.00 9.69m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M9.00 9.69m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0M11.00 9.69m-.3 0a.3 .3 0 1 0 .6 0a.3 .3 0 1 0-.6 0" /></svg>
            ) : (
              <svg class="flag" viewBox="0 0 30 20" aria-hidden="true"><rect width="30" height="20" fill="#da251d" /><path fill="#ff0" d="M15 4l3.53 10.85-9.24-6.7h11.42l-9.24 6.7z" /></svg>
            )
          }
          <span>{other === "en" ? "English" : "Tiếng Việt"}</span>
        </a>
        <button class="theme" type="button" data-theme-toggle>
          <span class="to-dark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z" /></svg><span>Dark</span></span>
          <span class="to-light"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg><span>Light</span></span>
        </button>
      </div>
    </header>

    <nav class="rail-r" aria-label={t("Điều hướng chính", "Main")}>
      {
        nav.map((item) => (
          <a href={url(lang, item.href)} data-astro-prefetch="viewport" aria-current={(item.href === "/" ? bare === "/" : bare.startsWith(item.href)) ? "page" : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={item.icon} />
            </svg>
            <span>{item.label}</span>
          </a>
        ))
      }
    </nav>

    <main class="sheet">
      <slot />
    </main>

    <footer class="site-foot sheet">
      <span>{t("Nha Trang, Việt Nam", "Nha Trang, Vietnam")}</span>
      <a href={email.href}>{email.value}</a>
    </footer>

    <script is:inline>
      const toggle = document.querySelector("[data-theme-toggle]");
      toggle.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        setTheme(next);
        try { localStorage.setItem("theme", next); } catch {}
      });

      // Bấm menu: chuyển trạng thái chọn ngay, không đợi trang mới tải xong.
      // Bấm Back (trang lấy lại từ bfcache) thì trả về mục của trang này.
      const menu = document.querySelector(".rail-r");
      const here = menu.querySelector("[aria-current]");
      const select = (a) => {
        for (const x of menu.querySelectorAll("a")) x.removeAttribute("aria-current");
        a?.setAttribute("aria-current", "page");
      };
      menu.addEventListener("click", (e) => {
        const a = e.target.closest("a");
        if (a && !(e.metaKey || e.ctrlKey || e.shiftKey || e.button)) select(a);
      });
      addEventListener("pageshow", (e) => e.persisted && select(here));

      // Đổi ngôn ngữ giữ chỗ đang đọc: nhớ khối đang ở đầu màn hình và đã cuộn qua bao nhiêu phần của nó,
      // trang kia cuộn tới đúng khối đó (hai bản có cùng cấu trúc nhưng chữ dài ngắn khác nhau).
      const blocks = () => [...document.querySelectorAll("main.sheet > *, .site-foot")];
      document.querySelector(".lang").addEventListener("click", (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button) return;
        const all = blocks();
        const i = all.findIndex((b) => b.getBoundingClientRect().bottom > 0);
        const r = all[i]?.getBoundingClientRect();
        const keep = { path: new URL(e.currentTarget.href).pathname, i, f: r ? -r.top / r.height : 0 };
        try { sessionStorage.setItem("lang-keep", JSON.stringify(keep)); } catch {}
      });
      try {
        const keep = JSON.parse(sessionStorage.getItem("lang-keep"));
        sessionStorage.removeItem("lang-keep");
        const b = keep?.path === location.pathname && blocks()[keep.i];
        if (b) {
          const r = b.getBoundingClientRect();
          scrollTo({ top: scrollY + r.top + keep.f * r.height, behavior: "instant" });
        }
      } catch {}

      // Link nội dung mở tab mới (kể cả link trong markdown).
      // Trừ: menu, logo, nút ngôn ngữ (hai rail), "View all" (.more),
      // mailto:/tel: (mở app) và #neo trong trang.
      for (const a of document.querySelectorAll("a[href]")) {
        if (a.closest(".rail-l, .rail-r, .more") || /^(mailto:|tel:|#)/.test(a.getAttribute("href"))) continue;
        a.target = "_blank";
        a.rel = "noopener";
      }
    </script>
  </body>
</html>
