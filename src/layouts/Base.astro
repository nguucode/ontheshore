---
import "../styles/global.css";
import { type Lang, T, url } from "../i18n";
import { contacts, email, phone } from "../data/contact";

interface Props {
  title?: string; // bỏ trống = trang chủ
  lang: Lang;
  description?: string;
}

const { title, lang } = Astro.props;
const t = T(lang);
const description = Astro.props.description ?? "Product Designer, UI/UX";

const site = "OnTheShore";
const fullTitle = title ? `${title} — ${site}` : "ontheshore";
const path = Astro.url.pathname;
const bare = path.replace(/^\/vi(?=\/)/, ""); // đường dẫn không kèm /vi
const other: Lang = lang === "en" ? "vi" : "en";
// Umami Cloud (gói Hobby miễn phí). Website ID lấy trong cloud.umami.is → Settings → Websites.
const umamiId = "927cfeb3-1366-49b5-a686-c58d067f90e3";
const canonical = new URL(path, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

// Thông tin cho Google (schema.org Person).
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ngưu Nguyễn",
  jobTitle: "Product Designer, UI/UX",
  url: Astro.site,
  image: new URL("/avatar.png", Astro.site),
  email: email.value,
  telephone: phone.href.slice(4),
  address: { "@type": "PostalAddress", addressLocality: "Nha Trang", addressCountry: "VN" },
  sameAs: contacts.filter((c) => c.href.startsWith("http")).map((c) => c.href),
};

// icon: path SVG 24x24, nét 1.5
const nav = [
  { href: "/", label: "Home", icon: "M4 11l8-7 8 7v9h-5v-6h-6v6H4z" },
  { href: "/about/", label: "About me", icon: "M12 12a4 4 0 100-8 4 4 0 000 8zM4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5" },
  { href: "/projects/", label: "Projects", icon: "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" },
  { href: "/products/", label: "Products", icon: "M12 3l8 4.5v9L12 21l-8-4.5v-9zM4 7.5l8 4.5 8-4.5M12 12v9" },
  { href: "/articles/", label: "Articles", icon: "M5 5h14M5 10h14M5 15h9M5 20h6" },
  { href: "/contact/", label: "Contact", icon: "M3 6h18v12H3zM3 6l9 7 9-7" },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Sáng/tối: lựa chọn đã lưu, không có thì theo máy. Chạy trước khi vẽ để không nháy màu.
      let saved;
      try { saved = localStorage.getItem("theme"); } catch {}
      document.documentElement.dataset.theme = saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={site} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "vi_VN"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#003c88" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14284f" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" hreflang="vi" href={new URL(url("vi", bare), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(url("en", bare), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(url("en", bare), Astro.site)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {umamiId && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={umamiId} data-domains="ontheshore.biz" />}
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;1,400&family=Space+Grotesk:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="rail-l">
      <a class="mark" href={url(lang, "/")} aria-label="Ngưu Nguyễn">
        <img src="/avatar.png" alt="" width="96" height="96" />
        <span class="mark-name">Ngưu Nguyễn</span>
        <span class="mark-sub">OnTheShore</span>
      </a>
      <div class="tools">
        <button class="lang theme" type="button" data-theme-toggle>
          <span class="to-dark">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z" /></svg>
            <span>Dark</span>
          </span>
          <span class="to-light">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <span>Light</span>
          </span>
        </button>
        <a class="lang" href={url(other, bare)} hreflang={other} lang={other}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18" /></svg>
          <span>{other === "en" ? "English" : "Tiếng Việt"}</span>
        </a>
      </div>
    </header>

    <nav class="rail-r" aria-label={t("Điều hướng chính", "Main")}>
      {
        nav.map((item) => (
          <a href={url(lang, item.href)} aria-current={(item.href === "/" ? bare === "/" : bare.startsWith(item.href)) ? "page" : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={item.icon} />
            </svg>
            <span>{item.label}</span>
          </a>
        ))
      }
      <a class="status" href={url(lang, "/contact/")}>
        <strong><span class="dot" aria-hidden="true"></span>Open to work</strong>
      </a>
    </nav>

    <main class="sheet">
      <slot />
    </main>

    <footer class="site-foot sheet">
      <span>Nha Trang, Việt Nam</span>
      <a href={email.href}>{email.value}</a>
      <span class="num">© ontheshore.biz</span>
    </footer>

    <script is:inline>
      document.querySelector("[data-theme-toggle]").addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
      });

      // Link ra ngoài site mở tab mới (gồm cả link trong markdown).
      for (const a of document.querySelectorAll('a[href^="http"]')) {
        if (a.host !== location.host) {
          a.target = "_blank";
          a.rel = "noopener";
        }
      }
    </script>
  </body>
</html>
