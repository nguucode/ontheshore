---
import Base from "../../layouts/Base.astro";
import { Image } from "astro:assets";
import portrait from "../../assets/portrait.png";
import { getLang, langPaths, T, url } from "../../i18n";
import { compact, totalUses } from "../../data/products";
import { email, linkedin, phone } from "../../data/contact";
import { community as communityOf, experience, skills, summary } from "../../data/cv";

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = T(lang);

// Community and Products: cùng nguồn với CV PDF (src/data/cv.ts).
const community = communityOf(compact(totalUses));

// Số năm và 5 design system/sản phẩm: sếp cung cấp 2026-10-01; 12 domain theo danh sách Domains trong cv.ts (2026-10-02). Lượt dùng template tính từ src/data/products.ts.
const facts = [
  { n: "7", label: t("năm làm product design", "years in product design") },
  { n: "12", label: t("domain, từ fintech, banking, ERP tới healthcare, logistics và IoT", "domains, from fintech, banking and ERP to healthcare, logistics and IoT") },
  { n: "5", label: t("design system và sản phẩm đang duy trì", "design systems and products maintained") },
  { n: compact(totalUses), label: t("lượt dùng các Figma template", "uses of the Figma templates") },
];
---

<Base title="About me" description={t(
    "Ngưu Nguyễn, Senior Product Designer với 7 năm trong fintech, CRM ngân hàng và logistics enterprise. Product design, design system và front-end. Nha Trang.",
    "Ngưu Nguyễn, Senior Product Designer with 7 years in fintech, banking CRM and enterprise logistics. Product design, design systems and front-end. Nha Trang, Vietnam."
  )} lang={lang}>
  <Image class="portrait" src={portrait} width={320} alt={t("Ảnh chân dung Ngưu Nguyễn", "Portrait of Ngưu Nguyễn")} loading="eager" />
  <h1>Ngưu Nguyễn</h1>
  <p class="lede">
    Senior Product Designer · {t("Nha Trang, Việt Nam · nhận làm remote", "Nha Trang, Vietnam · open to remote")}
  </p>
  <p>{summary[lang]}</p>
  <p>
    <a class="go" href="/nguu-nguyen-cv.pdf"><span class="go-ring" aria-hidden="true">↓</span>{t("Tải CV (PDF)", "Download CV (PDF)")}</a>
  </p>

  <h2>How the work is done</h2>
  <p>
    {t(
      "Tôi hợp với những sản phẩm có domain phức tạp, nơi sai sót phải trả giá đắt. Những sản phẩm này hiếm khi hỏng vì ý tưởng lớn. Chúng hỏng ở chi tiết: component không nhất quán, handoff chậm, cùng một bộ setup phải dựng lại cho mỗi dự án.",
      "I work best on products with dense domains, where mistakes are expensive. These products rarely fail on the big idea. They fail on the details: inconsistent components, slow handoffs, the same setup rebuilt for every project."
    )}
  </p>
  <p>
    {t(
      "Vì vậy tôi đầu tư vào design system và tooling: ít thành phần hơn, dùng nhất quán mỗi lần, để sản phẩm phức tạp vẫn đồng bộ khi lớn dần.",
      "That is why I invest in the design system and in tooling: fewer moving parts, used the same way every time, so complex products stay consistent as they grow."
    )}
  </p>

  <dl class="facts">
    {
      facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd class="num">{f.n}</dd>
        </div>
      ))
    }
  </dl>

  <h2>Experience</h2>
  <div>
    {
      experience.map((e) => (
        <div class="row">
          <div class="when num">{e.when}</div>
          <p class="what">
            <strong>{e.role}</strong>
            <br />
            <span class="where">
              {e.company} · {e.href ? <a href={url(lang, e.href)}>{e.kind[lang]}</a> : e.kind[lang]}
            </span>
            {e.what && (
              <>
                <br />
                {e.what[lang]}
              </>
            )}
          </p>
        </div>
      ))
    }
  </div>

  {/* Leadership: sếp sẽ bổ sung (quy mô team dẫn dắt, mentoring, quy trình đã xây). Mở comment khi có nội dung.
  <h2>Leadership</h2>
  <p>...</p>
  */}

  <h2>Skills</h2>
  <div>
    {
      skills.map((g) => (
        <div class="row">
          <div class="when">{g.group}</div>
          <ul class="chips">
            {g.items.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <h2>Community and Products</h2>
  <div>
    {
      community.map((it) => (
        <div class="row">
          <div class="when">{it.name}</div>
          <p class="what">
            {it.what[lang]} · <a href={it.href}>{it.href.replace(/^https:\/\/(www\.)?/, "").replace(/\/$/, "")}</a>
          </p>
        </div>
      ))
    }
  </div>
  <p class="more"><a href={url(lang, "/products/")}>{t("Xem tất cả sản phẩm", "See all products")} →</a></p>

  <h2>Contact</h2>
  <p>
    {t("Đang tìm vị trí senior product design làm remote, và nhận dự án freelance.", "Open to remote senior product design roles and freelance projects.")}
  </p>
  <p>
    <a class="go" href={email.href}><span class="go-ring" aria-hidden="true">→</span>{email.value}</a>
  </p>
  <p>
    <a class="go" href={linkedin.href}><span class="go-ring" aria-hidden="true">→</span>{linkedin.label}</a>
  </p>
  <p>
    <a class="go" href={phone.href}><span class="go-ring" aria-hidden="true">→</span>{phone.value}</a>
  </p>
</Base>
