---
import Base from "../../layouts/Base.astro";
import { Image } from "astro:assets";
import portrait from "../../assets/portrait.png";
import { getLang, langPaths, T, url } from "../../i18n";
import { compact, groups, totalUses } from "../../data/products";
import { email, linkedin } from "../../data/contact";
import { experience, skills } from "../../data/cv";

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = T(lang);

// Community: lấy thẳng từ src/data/products.ts để không lệch với trang Products.
const byKind = (kind: string) => groups.find((g) => g.kind === kind)!.items;
const templates = byKind("Figma");
const community = [
  {
    when: `${compact(totalUses)} ${t("lượt dùng", "uses")}`,
    name: t("Figma template", "Figma templates"),
    href: "https://www.figma.com/@nguunguyen73",
    note: templates.map((it) => it.name).join(", "),
  },
  ...byKind("Skill").map((it) => ({ when: "Figma AI skill", name: it.name, href: it.href!, note: it.note[lang], wip: it.wip })),
  ...byKind("OSS").map((it) => ({
    when: "Open source",
    name: it.name,
    href: it.local ? url(lang, it.href!) : it.href!,
    note: it.note[lang],
    wip: it.wip,
  })),
]

// Số năm và 5 design system/sản phẩm: sếp cung cấp 2026-10-01; 12 domain theo danh sách Domains trong cv.ts (2026-10-02). Lượt dùng template tính từ src/data/products.ts.
const facts = [
  { n: "7", label: t("năm làm product design", "years in product design") },
  { n: "12", label: t("domain, từ fintech, banking, ERP tới healthcare, logistics và IoT", "domains, from fintech, banking and ERP to healthcare, logistics and IoT") },
  { n: "5", label: t("design system và sản phẩm đang duy trì", "design systems and products maintained") },
  { n: compact(totalUses), label: t("lượt dùng các Figma template", "uses of the Figma templates") },
];
---

<Base title="About me" description={t(
    "Ngưu Nguyễn, Senior Product Designer với 7 năm trong fintech, CRM ngân hàng và logistics enterprise. Product design, design system và front-end. Nha Trang.",
    "Ngưu Nguyễn, Senior Product Designer with 7 years in fintech, banking CRM and enterprise logistics. Product design, design systems and front-end. Nha Trang, Vietnam."
  )} lang={lang}>
  <Image class="portrait" src={portrait} width={320} alt={t("Ảnh chân dung Ngưu Nguyễn", "Portrait of Ngưu Nguyễn")} loading="eager" />
  <h1>Ngưu Nguyễn</h1>
  <p class="lede">
    {
      t(
        "Senior Product Designer. 7 năm dành cho sản phẩm B2B phức tạp: fintech, CRM ngân hàng, logistics enterprise. Cư ngụ ở Nha Trang, Việt Nam.",
        "Senior Product Designer. 7 years spent on complex B2B products: fintech, banking CRM, enterprise logistics. Resides in Nha Trang, Vietnam."
      )
    }
  </p>
  <p>
    <a class="go" href="/nguu-nguyen-cv.pdf"><span class="go-ring" aria-hidden="true">↓</span>{t("Tải CV (PDF)", "Download CV (PDF)")}</a>
  </p>

  <h2>How the work is done</h2>
  <p>
    {t(
      "Thường chọn những sản phẩm có domain phức tạp, nơi sai một li là đi một dặm. Sản phẩm như thế hiếm khi gục ở ý tưởng lớn. Nó gục ở chi tiết: component lệch nhau, handoff ì ạch, cùng một bộ setup bị dựng lại cho mỗi dự án mới.",
      "Drawn to products where the domain is dense and errors cost dearly. Such products rarely fall at the grand idea. They fall in the details: components that disagree, handoffs that stall, the same setup rebuilt for every new project."
    )}
  </p>
  <p>
    {t(
      "Vì thế design system được coi là một sản phẩm thực thụ. Problem space được vẽ rõ trước khi bắt tay vào design, và công việc bám sát engineer, PM, PO, BA cho tới ngày ship. Front-end do chính tay này viết, tool cũng tự rèn lấy để gạt bỏ phần lặp lại trong việc design.",
      "So the design system is treated as a product in its own right. The problem space is mapped before any design begins, and the work stays close to engineers, PMs, POs and BAs until it ships. The front end is written by the same hand, and tools are forged to strip the repetition from design work."
    )}
  </p>
  <p>
    {t(
      "Ít bộ phận hơn, dùng nhất quán mỗi lần. Người ta nói hệ thống phức tạp trụ được là nhờ vậy.",
      "Fewer moving parts, used the same way each time. It is said that is how complex systems endure."
    )}
  </p>

  <dl class="facts">
    {
      facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd class="num">{f.n}</dd>
        </div>
      ))
    }
  </dl>

  <h2>Experience</h2>
  <div>
    {
      experience.map((e) => (
        <div class="row">
          <div class="when num">{e.when}</div>
          <p class="what">
            <strong>{e.role}</strong>
            <br />
            <span class="where">
              {e.company} · {e.href ? <a href={url(lang, e.href)}>{e.kind[lang]}</a> : e.kind[lang]}
            </span>
            {e.what && (
              <>
                <br />
                {e.what[lang]}
              </>
            )}
          </p>
        </div>
      ))
    }
  </div>

  {/* Leadership: sếp sẽ bổ sung (quy mô team dẫn dắt, mentoring, quy trình đã xây). Mở comment khi có nội dung.
  <h2>Leadership</h2>
  <p>...</p>
  */}

  <h2>Community and open source</h2>
  <div>
    {
      community.map((it) => (
        <div class="row">
          <div class="when num">{it.when}</div>
          <p class="what">
            <strong>
              <a href={it.href}>{it.name}</a>
            </strong>
            {it.wip && <span class="tag">{t("Đang phát triển", "In development")}</span>}
            <br />
            <span class="where">{it.note}</span>
          </p>
        </div>
      ))
    }
  </div>
  <p class="more"><a href={url(lang, "/products/")}>{t("Xem tất cả sản phẩm", "See all products")} →</a></p>

  <h2>Skills</h2>
  <div>
    {
      skills.map((g) => (
        <div class="row">
          <div class="when">{g.group}</div>
          <ul class="chips">
            {g.items.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <h2>Contact</h2>
  <p>
    {t("Đang tìm vị trí senior product design làm remote, và nhận dự án freelance.", "Open to remote senior product design roles and freelance projects.")}
  </p>
  <p>
    <a class="go" href={email.href}><span class="go-ring" aria-hidden="true">→</span>{email.value}</a>
  </p>
  <p>
    <a class="go" href={linkedin.href}><span class="go-ring" aria-hidden="true">→</span>{linkedin.label}</a>
  </p>
</Base>
