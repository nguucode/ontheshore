---
import Base from "../../layouts/Base.astro";
import { getLang, langPaths, T } from "../../i18n";

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = T(lang);
---

<Base title="About me" description={t(
    "Ngưu Nguyễn, Senior Product Designer cho sản phẩm SaaS và enterprise: CRM, ERP, fintech, kế toán. Product design, design system và front-end.",
    "Ngưu Nguyễn, Senior Product Designer for SaaS and enterprise products: CRM, ERP, fintech, accounting. Product design, design systems, front-end."
  )} lang={lang}>
  <h1>Ngưu Nguyễn</h1>
  <p class="lede">
    {
      t(
        "Senior Product Designer cho sản phẩm SaaS và enterprise. Đang ở Nha Trang, Việt Nam. Nhận cả vị trí full-time lẫn dự án freelance.",
        "Senior Product Designer for SaaS and enterprise products. Based in Nha Trang, Vietnam. Open to full-time roles and freelance projects."
      )
    }
  </p>

  {/* Experience: thêm khi có lịch sử làm việc. Mỗi dòng:
  <h2>Experience</h2>
  <div class="row">
    <div class="when">2023 — nay</div>
    <p class="what">
      <strong>Lead Product Designer</strong><br />
      <span class="where">Freelance</span><br />
      Mô tả một hoặc hai câu.
    </p>
  </div>
  */}

  <h2>Skills</h2>
  <p>Product design · Business analysis · Product ownership · Design systems and tokens · Front-end engineering · Shape Up and agile delivery</p>

  <h2>Domains</h2>
  <p>SaaS · CRM · ERP · Fintech · {t("Kế toán", "Accounting")}</p>

  <h2>Tools</h2>
  <p class="muted">Figma, Storybook, React, TypeScript, TailwindCSS.</p>

  <h2>Contact</h2>
  <p>
    <a href="mailto:nguunguyen.design@gmail.com">nguunguyen.design@gmail.com</a>
  </p>
</Base>
