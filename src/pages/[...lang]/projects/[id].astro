---
import Base from "../../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { byLang, getLang, langPaths, T, url } from "../../../i18n";

export async function getStaticPaths() {
  // Dev hiện cả bài draft để xem trước; build production vẫn loại.
  const all = await getCollection("projects", (p) => import.meta.env.DEV || !p.data.draft);
  return langPaths().flatMap(({ params }) =>
    byLang(all, getLang(params.lang)).map((p) => ({ params: { ...params, id: p.slug }, props: { entry: p } }))
  );
}

const lang = getLang(Astro.params.lang);
const t = T(lang);
const { entry } = Astro.props;
const { Content } = await render(entry);
const isUrl = (v: string) => /^https?:\/\//.test(v);
---

<Base title={entry.data.title} description={entry.data.summary} lang={lang}>
  <p class="faint"><a href={url(lang, "/projects/")}>← Projects</a></p>

  <h1 style={`view-transition-name:p-${entry.slug}`}>{entry.data.title}</h1>
  {/* có facts thì role/year đã nằm ở cột phải, bỏ dòng meta cho khỏi lặp */}
  {
    !entry.data.facts && (
      <p class="entry-meta num">
        {entry.data.role} · {entry.data.year}
        {entry.data.client ? ` · ${entry.data.client}` : ""}
      </p>
    )
  }
  <p class="lede">{entry.data.summary}</p>

  {
    entry.data.facts && (
      <aside class="project-facts">
        <dl>
          {Object.entries(entry.data.facts)
            .filter(([, value]) => !isUrl(value))
            .map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
        </dl>
        {/* fact có giá trị là URL thì thành link, chữ hiện là nhãn (Website, Figma...) */}
        <ul class="project-links">
          {Object.entries(entry.data.facts)
            .filter(([, value]) => isUrl(value))
            .map(([label, value]) => (
              <li>
                <a href={value} target="_blank" rel="noopener">
                  <span>{label}</span>↗
                </a>
              </li>
            ))}
        </ul>
      </aside>
    )
  }

  {
    entry.data.cover ? (
      <img class="cover" src={entry.data.cover} alt="" />
    ) : (
      <div class="cover placeholder" aria-hidden="true">
        <span>{t("Ảnh bìa chưa có.", "Cover image not yet added.")}</span>
      </div>
    )
  }

  <div class="prose">
    <Content />
  </div>
</Base>
