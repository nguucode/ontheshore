---
import Base from "../../../layouts/Base.astro";
import Row from "../../../components/Row.astro";
import { getCollection } from "astro:content";
import { byYear } from "../../../data/projects";
import { byLang, getLang, langPaths, T, url } from "../../../i18n";

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = T(lang);

const projects = byLang(await getCollection("projects", (p) => import.meta.env.DEV || !p.data.draft), lang).sort(byYear);
---

<Base title="Projects" description={t(
    "Project UI/UX của Ngưu Nguyễn: Shopify analytics app, accounting SaaS, React design system, icon library, IoT app. Problem, role, process, outcome.",
    "UI/UX projects by Ngưu Nguyễn: a Shopify analytics app, an accounting SaaS, a React design system, an icon library and an IoT app."
  )} lang={lang}>
  <section class="sec">
    <h1 class="sec-label">Projects</h1>
    <div class="intro">
      <p class="headline">{t("Sản phẩm SaaS, enterprise và mobile tôi đã thiết kế.", "SaaS, enterprise and mobile products I've designed.")}</p>
    </div>

    {
      projects.length === 0 ? (
        <div class="empty span-3">
          <p style="margin:0 0 .6rem">{t("Chưa project nào được publish.", "No project has been published yet.")}</p>
          <p style="margin:0" class="faint">
            <code>src/content/projects/{lang}/_template.md</code>
          </p>
        </div>
      ) : (
        <ul class="ix">
          {projects.map((p, i) => (
            <Row
              href={url(lang, `/projects/${p.slug}/`)}
              title={p.data.title}
              lead={p.data.year}
              meta={p.data.client}
              kicker={p.data.role}
              note={p.data.summary}
              vt={`p-${p.slug}`}
              i={i}
            />
          ))}
        </ul>
      )
    }
  </section>
</Base>
