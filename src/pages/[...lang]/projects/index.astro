---
import Base from "../../../layouts/Base.astro";
import Row from "../../../components/Row.astro";
import { getCollection } from "astro:content";
import { byLang, getLang, langPaths, T, url } from "../../../i18n";

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = T(lang);

const projects = byLang(await getCollection("projects", (p) => !p.data.draft), lang).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title={t("Dự án", "Projects")} description={t(
    "Case study UI/UX của Ngưu Nguyễn: Shopify app, design system, thư viện icon, app IoT. Vấn đề, vai trò, quá trình, kết quả.",
    "UI/UX case studies by Ngưu Nguyễn: a Shopify app, a design system, an icon library, an IoT app. Problem, role, process, outcome."
  )} lang={lang}>
  <h1>{t("Dự án", "Projects")}</h1>
  <p class="lede">{t("Case study. Vấn đề, vai trò, quá trình, kết quả.", "Case studies. Problem, role, process, outcome.")}</p>

  {
    projects.length === 0 ? (
      <div class="empty">
        <p style="margin:0 0 .6rem">{t("Chưa có case study nào được publish.", "No case studies published yet.")}</p>
        <p style="margin:0" class="faint">
          <code>src/content/projects/{lang}/_template.md</code>
        </p>
      </div>
    ) : (
      <ul class="ix">
        {projects.map((p, i) => (
          <Row
            href={url(lang, `/projects/${p.slug}/`)}
            title={p.data.title}
            lead={p.data.year}
            meta={p.data.client}
            kicker={p.data.role}
            note={p.data.summary}
            vt={`p-${p.slug}`}
            i={i}
          />
        ))}
      </ul>
    )
  }
</Base>
