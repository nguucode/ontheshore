---
import Base from "../../layouts/Base.astro";
import Row from "../../components/Row.astro";
import { getLang, langPaths, T, url } from "../../i18n";
import { compact, groups, totalFree, totalPaid, totalPublished } from "../../data/products";

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = T(lang);
---

<Base
  title="Products"
  description={t(
    "App, Figma template, AI skill và UI kit của Ngưu Nguyễn, có bản miễn phí và trả phí. Hơn 100k lượt dùng trên Figma Community.",
    "Apps, Figma templates, AI skills and UI kits by Ngưu Nguyễn, free and paid. 100k+ uses on Figma Community."
  )}
  lang={lang}
>
  <h1>Products</h1>
  <p class="lede">
    {t(`${totalPublished} thứ đã publish, dùng được ngay. ${totalFree} thứ miễn phí, để ngỏ cho bất kỳ ai cần. ${totalPaid} thứ trả phí, có dùng thử.`, `${totalPublished} things published, ready to use. ${totalFree} are free, left open for any who need them. ${totalPaid} paid, with a free trial.`)}
  </p>

  {
    groups.map((g) => (
      <>
        <h2>{g.heading[lang]}</h2>
        {g.items.length === 0 ? (
          <div class="empty">{t("Mục này chưa có gì được publish.", "Nothing has been published here yet.")}</div>
        ) : (
          <ul class="ix">
            {g.items.map((it, i) => (
              <Row
                href={it.href && (it.local ? url(lang, it.href) : it.href)}
                title={it.name}
                lead={it.uses ? compact(it.uses) : (it.price ?? "—")}
                meta={it.uses ? t("lượt dùng", "uses") : undefined}
                kicker={it.kind ?? g.kind}
                flag={!it.href || it.wip ? t("Đang phát triển", "In development") : undefined}
                note={it.note[lang]}
                i={i}
              />
            ))}
          </ul>
        )}
      </>
    ))
  }

  <hr />
  <p class="faint">
    {t("Hồ sơ đầy đủ:", "Full profile:")}{" "}
    <a href="https://www.figma.com/@nguunguyen73" rel="noopener">
      figma.com/@nguunguyen73
    </a>
  </p>
</Base>
