---
import Base from "../../layouts/Base.astro";
import Row from "../../components/Row.astro";
import { getLang, langPaths, T, url } from "../../i18n";
import { compact, groups } from "../../data/products";

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = T(lang);
---

<Base
  title="Products"
  description={t(
    "App và Figma template của Ngưu Nguyễn, có bản miễn phí và trả phí. Hơn 100k lượt dùng trên Figma Community.",
    "Apps and Figma templates by Ngưu Nguyễn, free and paid. 100k+ uses on Figma Community."
  )}
  lang={lang}
>
  <section class="sec">
    <h1 class="sec-label">Products</h1>
    <div class="intro">
      <p class="headline">{t("App và Figma template tôi làm cho người dùng.", "Apps and Figma templates I make for users.")}</p>
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="sec">
        <h2 class="sec-label">{g.heading[lang]}</h2>
        {g.items.length === 0 ? (
          <div class="empty span-3">{t("Mục này chưa có gì được publish.", "Nothing has been published here yet.")}</div>
        ) : (
          <ul class="ix">
            {g.items.map((it, i) => (
              <Row
                href={it.href && (it.local ? url(lang, it.href) : it.href)}
                title={it.name}
                lead={it.uses ? compact(it.uses) : (it.price ?? (it.free ? t("Miễn phí", "Free") : "—"))}
                meta={it.uses ? t("lượt dùng", "uses") : undefined}
                kicker={it.kind ?? g.kind}
                flag={!it.href || it.wip ? t("Đang phát triển", "In development") : undefined}
                note={it.note[lang]}
                media={it.thumb?.src ?? ""}
                i={i}
              />
            ))}
          </ul>
        )}
      </section>
    ))
  }
</Base>
