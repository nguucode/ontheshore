---
import Base from "../../layouts/Base.astro";
import Row from "../../components/Row.astro";
import { getLang, langPaths, T, url } from "../../i18n";
import { compact, groups, totalFree, totalPaid, totalPublished, totalUses } from "../../data/products";

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = T(lang);
---

<Base
  title="Products"
  description={t(
    "App, Figma template, AI skill và UI kit của Ngưu Nguyễn, có bản miễn phí và trả phí. Hơn 100k lượt dùng trên Figma Community.",
    "Apps, Figma templates, AI skills and UI kits by Ngưu Nguyễn, free and paid. 100k+ uses on Figma Community."
  )}
  lang={lang}
>
  <section class="sec">
    <h1 class="sec-label">Products</h1>
    <div class="intro">
      <p class="headline">{t("App, Figma template và kit tôi làm cho designer khác dùng.", "Apps, Figma templates and kits I make for other designers.")}</p>
      <p class="lede">
        {t(
          `${totalPublished} sản phẩm đã publish: ${totalFree} miễn phí, ${totalPaid} trả phí có dùng thử. Riêng template trên Figma Community đã có ${compact(totalUses)} lượt dùng.`,
          `${totalPublished} published: ${totalFree} free, ${totalPaid} paid with a free trial. The Figma Community templates alone have ${compact(totalUses)} uses.`
        )}
      </p>
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="sec">
        <h2 class="sec-label">{g.heading[lang]}</h2>
        {g.items.length === 0 ? (
          <div class="empty span-3">{t("Mục này chưa có gì được publish.", "Nothing has been published here yet.")}</div>
        ) : (
          <ul class="ix">
            {g.items.map((it, i) => (
              <Row
                href={it.href && (it.local ? url(lang, it.href) : it.href)}
                title={it.name}
                lead={it.uses ? compact(it.uses) : (it.price ?? "—")}
                meta={it.uses ? t("lượt dùng", "uses") : undefined}
                kicker={it.kind ?? g.kind}
                flag={!it.href || it.wip ? t("Đang phát triển", "In development") : undefined}
                note={it.note[lang]}
                i={i}
              />
            ))}
          </ul>
        )}
      </section>
    ))
  }

  <section class="sec">
    <p class="faint span-3">
      {t("Hồ sơ đầy đủ:", "Full profile:")}{" "}
      <a href="https://www.figma.com/@nguunguyen73" rel="noopener">
        figma.com/@nguunguyen73
      </a>
    </p>
  </section>
</Base>
