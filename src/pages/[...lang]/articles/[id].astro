---
import Base from "../../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { byLang, getLang, langPaths, T, url } from "../../../i18n";

export async function getStaticPaths() {
  const all = await getCollection("articles", (a) => !a.data.draft);
  return langPaths().flatMap(({ params }) =>
    byLang(all, getLang(params.lang)).map((a) => ({ params: { ...params, id: a.slug }, props: { entry: a } }))
  );
}

const lang = getLang(Astro.params.lang);
const t = T(lang);
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary} lang={lang}>
  <p class="faint"><a href={url(lang, "/articles/")}>← Articles</a></p>

  <h1>{entry.data.title}</h1>
  <p class="entry-meta num">{entry.data.date.toISOString().slice(0, 10)}</p>

  <div class="prose">
    <Content />
  </div>
</Base>
