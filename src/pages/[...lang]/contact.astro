---
import Base from "../../layouts/Base.astro";
import Row from "../../components/Row.astro";
import { getLang, langPaths, T } from "../../i18n";
import { contacts } from "../../data/contact";

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = T(lang);
---

<Base title="Contact" description={t(
    "Liên hệ Ngưu Nguyễn để thuê UI/UX designer freelance: điện thoại, email, Zalo, LinkedIn, Facebook, Figma.",
    "Hire Ngưu Nguyễn for freelance UI/UX design. Reach out by phone, email, Zalo, LinkedIn, Facebook or Figma."
  )} lang={lang}>
  <h1>Contact</h1>
  <p class="lede">{t("Cư ngụ ở Nha Trang, bên bờ vịnh. Tạm thời là vậy.", "Resides in Nha Trang, on the shore of the bay. For now.")}</p>

  <ul class="ix">
    {contacts.map((c, i) => <Row href={c.href} title={c.value} lead={c.label} i={i} />)}
  </ul>
</Base>
