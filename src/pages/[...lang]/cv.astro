---
import Base from "../../layouts/Base.astro";
import { getLang, langPaths, T } from "../../i18n";

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = T(lang);
---

<Base title="CV" description="Ngưu Nguyễn — Senior / Lead Product Designer." lang={lang}>
  <h1>Ngưu Nguyễn</h1>
  <p class="lede">
    {
      t(
        "Senior / Lead Product Designer. UI/UX, product design. Nha Trang, Việt Nam. Freelance.",
        "Senior / Lead Product Designer. UI/UX, product design. Based in Nha Trang, Vietnam. Freelance."
      )
    }
  </p>

  <h2>{t("Kinh nghiệm", "Experience")}</h2>
  <div class="empty">
    [Cần sếp cung cấp: lịch sử làm việc. Mỗi dòng cần năm, vai trò, nơi làm, và
    1-2 câu về việc đã làm.]
  </div>

  {/* Cấu trúc sẵn, điền vào rồi xoá khối .empty ở trên:
  <div class="row">
    <div class="when">2023 — nay</div>
    <p class="what">
      <strong>Lead Product Designer</strong><br />
      <span class="where">Freelance</span><br />
      Mô tả một hoặc hai câu.
    </p>
  </div>
  */}

  <h2>{t("Kỹ năng", "Skills")}</h2>
  <div class="empty">
    [Cần sếp cung cấp: nhóm kỹ năng. Ví dụ Product design, Design systems,
    Research, Prototyping, Front-end.]
  </div>

  <h2>{t("Công cụ", "Tools")}</h2>
  <p class="muted">Figma, Storybook, TailwindCSS, TypeScript.</p>

  <h2>{t("Liên hệ", "Contact")}</h2>
  <p>
    <a href="mailto:kafka@ontheshore.biz">kafka@ontheshore.biz</a>
  </p>

  <hr />
  <p class="faint">
    [Quyết định chưa chốt: có làm bản PDF tải về không.]
  </p>
</Base>
