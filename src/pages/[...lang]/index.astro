---
import Base from "../../layouts/Base.astro";
import Row from "../../components/Row.astro";
import { Image } from "astro:assets";
import nhaTrang from "../../assets/nha-trang.jpg";
import { getCollection } from "astro:content";
import { byLang, getLang, langPaths, T, url } from "../../i18n";
import { all, compact, topByUses, totalPublished, totalUses } from "../../data/products";
import { email, linkedin, phone } from "../../data/contact";

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = T(lang);

const projects = byLang(await getCollection("projects", (p) => !p.data.draft), lang)
  .sort((a, b) => a.data.order - b.data.order);
const homeProjects = projects.slice(0, 3);

// Có lượt dùng xếp trước, theo số lượt dùng.
const products = [...all].sort((a, b) => (b.uses ?? 0) - (a.uses ?? 0)).slice(0, 3);

const featured = topByUses[0];
---

<Base lang={lang}>
  <section class="sec">
    <h2 class="sec-label">About</h2>
    <div class="intro">
      <h1>{"Product designer, UI/UX."}</h1>
      <p class="lede">
        {
          t(
            "Tôi thiết kế sản phẩm SaaS và enterprise: CRM, ERP, fintech, kế toán. Tôi làm cả product design, business analysis lẫn product ownership, và tự code front-end. Phần lớn team làm hệ thống phức tạp hơn mức cần. Việc của tôi là cắt bớt sự phức tạp đó.",
            "I design SaaS and enterprise products: CRM, ERP, fintech and accounting. I work across product design, business analysis and product ownership, and I build the front end myself. Most teams overcomplicate their systems. My job is to cut that back."
          )
        }
      </p>
    </div>
    <dl class="proof">
      <div>
        <dt>{t("lượt dùng template trên Figma Community", "template uses on Figma Community")}</dt>
        <dd class="num">{compact(totalUses)}</dd>
      </div>
      <div>
        <dt>{t("sản phẩm đã publish, miễn phí", "products published, all free")}</dt>
        <dd class="num">{totalPublished}</dd>
      </div>
    </dl>
  </section>

  <section class="sec feature">
    <h2 class="sec-label">Featured</h2>
    <div class="feature-text">
      <span class="tag">Figma Community</span>
      <p class="kicker">{t("Template · miễn phí", "Template · free")}</p>
      <h3 class="feature-title">{featured.name}</h3>
      <p class="feature-sub">{featured.note[lang]}</p>
      <p class="feature-stat">
        <span class="num">{compact(featured.uses!)}</span>
        {t("lượt dùng", "uses")}
      </p>
      <a class="go" href={featured.href} rel="noopener">
        <span class="go-ring" aria-hidden="true">→</span>{t("Xem trên Figma", "Open in Figma")}
      </a>
    </div>
    {
      featured.thumb ? (
        <Image
          class="feature-media"
          src={featured.thumb}
          widths={[600, 1000, featured.thumb.width]}
          sizes="(max-width: 60rem) 100vw, 50vw"
          alt={featured.name}
        />
      ) : (
        <div class="feature-media placeholder" aria-hidden="true">
          <span>{t("Ảnh sản phẩm — sẽ cập nhật", "Product image — coming soon")}</span>
        </div>
      )
    }
  </section>

  <section class="sec">
    <h2 class="sec-label">Projects</h2>
    {
      projects.length === 0 ? (
        <div class="empty span-3">
          {t("Chưa có case study nào.", "No case studies yet.")} <code>src/content/projects/{lang}/</code>
        </div>
      ) : (
        <ul class="ix">
          {homeProjects.map((p, i) => (
            <Row
              href={url(lang, `/projects/${p.slug}/`)}
              title={p.data.title}
              lead={p.data.year}
              meta={p.data.client}
              kicker={p.data.role}
              vt={`p-${p.slug}`}
              i={i}
            />
          ))}
        </ul>
      )
    }
    <p class="more span-3">
      <a href={url(lang, "/projects/")}>View all →</a>
    </p>
  </section>

  <section class="sec">
    <h2 class="sec-label">Products</h2>
    <ul class="ix">
      {
        products.map((it, i) => (
          <Row
            href={it.href && (it.local ? url(lang, it.href) : it.href)}
            title={it.name}
            lead={it.uses ? compact(it.uses) : "—"}
            meta={it.uses ? t("lượt dùng", "uses") : undefined}
            kicker={it.kind}
            flag={!it.href || it.wip ? t("Đang phát triển", "In development") : undefined}
            note={it.note[lang]}
            i={i}
          />
        ))
      }
    </ul>
    <p class="more span-3">
      <a href={url(lang, "/products/")}>View all →</a>
    </p>
  </section>

  <Image
    class="band"
    src={nhaTrang}
    widths={[800, 1400, 2000]}
    sizes="(max-width: 60rem) 100vw, calc(100vw - 12.5rem)"
    alt={t(
      "Thuyền thúng và thuyền đánh cá trên vịnh Nha Trang, phía xa là thành phố và núi.",
      "Basket boats and fishing boats on Nha Trang bay, with the city and mountains behind."
    )}
  />

  <section class="sec">
    <h2 class="sec-label">Contact</h2>
    <div class="span-2">
      <p>{t("Hiện tại đang sống ở Nha Trang.", "Living in Nha Trang, for now.")}</p>
      <p><a class="go" href={phone.href}><span class="go-ring" aria-hidden="true">→</span>{phone.value}</a></p>
      <p><a class="go" href={email.href}><span class="go-ring" aria-hidden="true">→</span>{email.value}</a></p>
      <p><a class="go" href={linkedin.href}><span class="go-ring" aria-hidden="true">→</span>{linkedin.label}</a></p>
    </div>
  </section>
</Base>
