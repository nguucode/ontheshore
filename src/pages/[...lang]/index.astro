---
import Base from "../../layouts/Base.astro";
import Row from "../../components/Row.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import nhaTrang from "../../assets/nha-trang.jpg";
import { getCollection } from "astro:content";
import { byYear } from "../../data/projects";
import { byLang, getLang, langPaths, T, url } from "../../i18n";
import { all, compact, topByUses, totalFree, totalUses } from "../../data/products";
import { email, linkedin, phone } from "../../data/contact";

export const getStaticPaths = langPaths;

const lang = getLang(Astro.params.lang);
const t = T(lang);

const projects = byLang(await getCollection("projects", (p) => !p.data.draft), lang)
  .sort(byYear);

// Có lượt dùng xếp trước, theo số lượt dùng.
const products = [...all].sort((a, b) => (b.uses ?? 0) - (a.uses ?? 0)).slice(0, 3);

// Featured: 5 slide cùng khung: tag nền tảng, kicker "loại · chi tiết", mô tả 120–150 ký tự, một số liệu.
type Slide = {
  tag: string;
  kicker: string;
  title: string;
  desc: string;
  stat: { value: string; unit: string };
  href: string;
  cta: string;
  thumb?: ImageMetadata;
  poster?: { top: string; bottom: string };
};
const top = topByUses[0];
const app = all.find((it) => it.price && it.href)!;
const shot = all.find((it) => it.name === "ShoreShot")!;
const accountkit = projects.find((p) => p.slug === "accountkit")!;
const zweihander = projects.find((p) => p.slug === "zweihander")!;
// project đã nằm ở slide Featured thì không lặp lại ở danh sách Projects
const homeProjects = projects.filter((p) => p !== accountkit && p !== zweihander).slice(0, 3);
const slides: Slide[] = [
  {
    tag: "Figma Community",
    kicker: t("Template · miễn phí", "Template · free"),
    title: top.name,
    desc: t(
      "Donut, pie, progress, radial bar và rose chart cho dashboard, dựng bằng Auto Layout, đủ light và dark theme. Template được dùng nhiều nhất.",
      "Donut, pie, progress, radial bar and rose charts for dashboards, built on Auto Layout, light and dark themes. My most-used Figma template."
    ),
    stat: { value: compact(top.uses!), unit: t("lượt dùng", "uses") },
    href: top.href!,
    cta: t("Xem trên Figma", "Open in Figma"),
    thumb: top.thumb,
  },
  {
    tag: app.kind!,
    kicker: `App · ${app.price}`,
    title: app.name,
    desc: t(
      "Đặt ảnh chụp màn hình hoặc frame Figma lên thiết bị 3D thật, xoay tới góc ưng ý, xuất PNG nền trong suốt. Web app đã chạy, plugin đang chờ duyệt.",
      "Put a screenshot or a Figma frame on a real 3D device, turn it to any angle and export a transparent PNG. Web app live, Figma plugin in review."
    ),
    stat: { value: "50", unit: t("lượt xuất đầu miễn phí", "free exports to start") },
    href: app.href!,
    cta: t("Xem sản phẩm", "View the product"),
    thumb: app.thumb,
  },
  {
    tag: shot.kind!,
    kicker: t("App · miễn phí", "App · free"),
    title: shot.name,
    desc: t(
      "Chụp màn hình, chú thích bằng khung, chữ hoặc bút, rồi copy hoặc dán thẳng vào app đang dùng. Chạy nền ở thanh menu macOS, khay hệ thống Windows.",
      "Capture your screen, mark it up with shapes, text or a pen, then copy it or paste it straight into the app you were using. Runs from the menu bar."
    ),
    stat: { value: "3", unit: t("kiểu chụp: vùng, cửa sổ, cả màn hình", "capture modes: area, window, full screen") },
    href: shot.href!,
    cta: t("Xem trang app", "Visit the site"),
    thumb: shot.thumb,
  },
  {
    tag: t("SaaS kế toán", "Accounting SaaS"),
    kicker: `Project · ${accountkit.data.year}`,
    title: accountkit.data.title,
    desc: t(
      "Design system, thiết kế sản phẩm và quy trình làm việc với Claude Code cho SaaS kế toán ở Úc, để CEO tự làm prototype thể hiện ý tưởng.",
      "A design system, product design and a Claude Code workflow for an Australian accounting SaaS, so the CEO can build a prototype to show an idea."
    ),
    stat: { value: "6", unit: t("tháng, team 7 người", "months, team of 7") },
    href: url(lang, `/projects/${accountkit.slug}/`),
    cta: t("Xem project", "View the project"),
    poster: { top: accountkit.data.year, bottom: accountkit.data.role },
  },
  {
    tag: "React + Figma",
    kicker: `Project · ${zweihander.data.year}`,
    title: "Zweihänder",
    desc: t(
      "Design system cho React tôi dựng lại công khai, lấy code làm nguồn token duy nhất để Figma đi theo, nên design và code không lệch nhau nữa.",
      "A React design system I rebuilt in public, with code as the only source of tokens and Figma following, so design and code cannot drift apart."
    ),
    stat: { value: "6", unit: t("tuần, mã nguồn mở", "weeks, open source") },
    href: url(lang, `/projects/${zweihander.slug}/`),
    cta: t("Xem project", "View the project"),
    poster: { top: zweihander.data.year, bottom: zweihander.data.role },
  },
];

// Mô tả lệch khỏi 120–150 ký tự thì build hỏng, khỏi phải nhớ mà đếm.
for (const sl of slides) {
  const n = [...sl.desc].length;
  if (n < 120 || n > 150) throw new Error(`Featured "${sl.title}" (${lang}): mô tả ${n} ký tự, cần 120–150.`);
}
---

<Base lang={lang}>
  <section class="sec">
    <h2 class="sec-label">About</h2>
    <div class="intro">
      <h1>{"Product designer, UI/UX."}</h1>
      <p class="lede">
        {
          t(
            "Thiết kế sản phẩm SaaS và enterprise: CRM, ERP, fintech, kế toán. Làm product design, business analysis, product ownership, và tự viết front-end.",
            "I design SaaS and enterprise products: CRM, ERP, fintech, accounting. Product design, business analysis and product ownership, and I build the front end myself."
          )
        }
      </p>
      <p class="lede">
        {
          t(
            "Phần lớn team dựng hệ thống phức tạp hơn mức công việc cần. Tôi giữ chúng gọn nhất có thể.",
            "Most teams build systems more complex than the work needs. I keep them as simple as the work allows."
          )
        }
      </p>
    </div>
    <dl class="proof">
      <div>
        <dt>{t("lượt dùng template trên Figma Community", "template uses on Figma Community")}</dt>
        <dd class="num">{compact(totalUses)}</dd>
      </div>
      <div>
        <dt>{t("sản phẩm đã publish, miễn phí", "products published, all free")}</dt>
        <dd class="num">{totalFree}</dd>
      </div>
    </dl>
  </section>

  <section class="sec feature" data-slider aria-roledescription="carousel" aria-label="Featured">
    <div class="feature-head">
      <button class="feature-bar" type="button" aria-label={t("Slide kế", "Next slide")}></button>
      <h2 class="sec-label">Featured</h2>
    </div>
    <div class="feature-track">
      {
        slides.map((sl, i) => (
          <article class="feature-slide" aria-roledescription="slide" aria-label={`${i + 1} / ${slides.length}`} data-on={i === 0 ? "" : undefined}>
            <div class="feature-text">
              <span class="tag">{sl.tag}</span>
              <p class="kicker">{sl.kicker}</p>
              <h3 class="feature-title">{sl.title}</h3>
              <p class="feature-sub">{sl.desc}</p>
              <p class="feature-stat">
                <span class="num">{sl.stat.value}</span>
                {sl.stat.unit}
              </p>
              <a class="go" href={sl.href} rel={sl.href.startsWith("http") ? "noopener" : undefined}>
                <span class="go-ring" aria-hidden="true">→</span>{sl.cta}
              </a>
            </div>
            {sl.thumb ? (
              <Image
                class="feature-media"
                src={sl.thumb}
                widths={[600, 1000, sl.thumb.width]}
                sizes="(max-width: 79.99rem) 100vw, 50vw"
                alt={sl.title}
              />
            ) : (
              /* chưa có ảnh: poster chữ nền accent */
              <div class="feature-media poster" aria-hidden="true">
                <span class="num">{sl.poster?.top}</span>
                <strong>{sl.title}</strong>
                <span>{sl.poster?.bottom}</span>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <script>
    // Slide Featured: scroll-snap gốc. Gạch accent trên nhãn là thanh thời gian:
    // chạy hết hoặc bấm vào thì sang slide kế; đổi slide (tự hay vuốt) thì chạy lại từ đầu.
    // Reduced-motion tắt animation nên không tự chuyển.
    for (const root of document.querySelectorAll<HTMLElement>("[data-slider]")) {
      const track = root.querySelector<HTMLElement>(".feature-track")!;
      const bar = root.querySelector<HTMLElement>(".feature-bar")!;
      const slides = [...track.children];
      let cur = 0;
      track.addEventListener(
        "scroll",
        () => {
          const i = Math.round(track.scrollLeft / track.clientWidth);
          if (i === cur) return;
          slides[cur].removeAttribute("data-on");
          slides[i].setAttribute("data-on", "");
          cur = i;
          bar.style.animation = "none";
          void bar.offsetWidth; // ép reflow để animation chạy lại
          bar.style.animation = "";
        },
        { passive: true }
      );
      const next = () => track.scrollTo({ left: ((cur + 1) % slides.length) * track.clientWidth, behavior: "smooth" });
      bar.addEventListener("animationend", next);
      bar.addEventListener("click", next);
    }
  </script>

  <section class="sec">
    <h2 class="sec-label">Projects</h2>
    {
      projects.length === 0 ? (
        <div class="empty span-3">
          {t("Chưa có project nào.", "No projects yet.")} <code>src/content/projects/{lang}/</code>
        </div>
      ) : (
        <ul class="ix">
          {homeProjects.map((p, i) => (
            <Row
              href={url(lang, `/projects/${p.slug}/`)}
              title={p.data.title}
              lead={p.data.year}
              meta={p.data.client}
              kicker={p.data.role}
              note={p.data.summary}
              vt={`p-${p.slug}`}
              i={i}
            />
          ))}
        </ul>
      )
    }
    <p class="more span-3">
      <a href={url(lang, "/projects/")}>View all →</a>
    </p>
  </section>

  <section class="sec">
    <h2 class="sec-label">Products</h2>
    <ul class="ix">
      {
        products.map((it, i) => (
          <Row
            href={it.href && (it.local ? url(lang, it.href) : it.href)}
            title={it.name}
            lead={it.uses ? compact(it.uses) : (it.price ?? (it.free ? t("Miễn phí", "Free") : "—"))}
            meta={it.uses ? t("lượt dùng", "uses") : undefined}
            kicker={it.kind}
            flag={!it.href || it.wip ? t("Đang phát triển", "In development") : undefined}
            note={it.note[lang]}
            i={i}
          />
        ))
      }
    </ul>
    <p class="more span-3">
      <a href={url(lang, "/products/")}>View all →</a>
    </p>
  </section>

  <Image
    class="band"
    src={nhaTrang}
    widths={[800, 1400, 2000]}
    sizes="(max-width: 79.99rem) 100vw, calc(100vw - 12.5rem)"
    alt={t(
      "Thuyền thúng và thuyền đánh cá trên vịnh Nha Trang, phía xa là thành phố và núi.",
      "Basket boats and fishing boats on Nha Trang bay, with the city and mountains behind."
    )}
  />

  <section class="sec">
    <h2 class="sec-label">Contact</h2>
    <div class="span-2">
      <p>{t("Sống ở Nha Trang, Việt Nam. Nhận làm remote.", "Based in Nha Trang, Vietnam. Open to remote work.")}</p>
      <p><a class="go" href={phone.href}><span class="go-ring" aria-hidden="true">→</span>{phone.value}</a></p>
      <p><a class="go" href={email.href}><span class="go-ring" aria-hidden="true">→</span>{email.value}</a></p>
      <p><a class="go" href={linkedin.href}><span class="go-ring" aria-hidden="true">→</span>{linkedin.label}</a></p>
    </div>
  </section>
</Base>
