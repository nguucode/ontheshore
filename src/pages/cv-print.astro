---
// Bản in của CV, khổ A4 một trang, tiếng Anh. Không nằm trong menu hay sitemap.
// `npm run cv` build rồi in trang này ra public/nguu-nguyen-cv.pdf bằng Chrome (macOS).
import { experience, skills } from "../data/cv";
import { email, linkedin, phone } from "../data/contact";
import { compact, totalUses } from "../data/products";

// Community and Products: ba nơi xem hết sản phẩm (sếp chọn 2026-10-05). Link ghi rõ để in ra giấy vẫn đọc được.
const products = [
  { name: "Figma", what: `Free templates and an AI skill, ${compact(totalUses)} uses`, href: "https://www.figma.com/@nguunguyen73" },
  { name: "Gumroad", what: "Kusabimaru, 3D device mockups for web and Figma", href: "https://kafkawaves.gumroad.com/" },
  { name: "Website", what: "All products, case studies and the Zweihänder UI kit", href: "https://ontheshore.biz/" },
];
const bare = (u: string) => u.replace(/^https:\/\/(www\.)?/, "").replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Ngưu Nguyễn — CV</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&family=Space+Grotesk:wght@400;500&display=block"
    />
    <style is:inline>
      @page {
        size: A4;
        margin: 0;
      }
      :root {
        --ink: #1c1d21;
        --soft: #565a64;
        --faint: #8a8d96;
        --accent: #003c88;
        --rule: rgba(0, 60, 136, 0.16);
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        width: 210mm;
        min-height: 297mm;
        padding: 16mm 17mm 14mm;
        font: 9.6pt/1.5 "Be Vietnam Pro", sans-serif;
        color: var(--ink);
        background: #fff;
      }
      /* link phải nhìn ra ngay là bấm được: màu chàm, gạch chân */
      a {
        color: var(--accent);
        text-decoration: underline;
        text-decoration-thickness: 0.6pt;
        text-underline-offset: 1.6pt;
      }
      .num {
        font-family: "Space Grotesk", sans-serif;
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 8mm;
        padding-bottom: 5mm;
        border-bottom: 2px solid var(--accent);
      }
      h1 {
        margin: 0;
        font-size: 24pt;
        font-weight: 600;
        line-height: 1.1;
        color: var(--accent);
      }
      .title {
        margin: 1.5mm 0 0;
        font-size: 11pt;
        font-weight: 500;
      }
      .contact {
        margin: 0;
        list-style: none;
        padding: 0;
        text-align: right;
        font-size: 8.6pt;
        color: var(--soft);
      }
      h2 {
        margin: 5mm 0 2.5mm;
        font-size: 8pt;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent);
      }
      .summary {
        margin: 5mm 0 0;
        color: var(--soft);
      }
      .job {
        display: grid;
        grid-template-columns: 24mm 1fr;
        gap: 4mm;
        padding: 2mm 0;
        border-top: 1px solid var(--rule);
      }
      .job:first-of-type {
        border-top: 0;
        padding-top: 0;
      }
      .when {
        font-size: 8.6pt;
        color: var(--faint);
        padding-top: 0.4mm;
      }
      .job p {
        margin: 0;
      }
      .role {
        font-weight: 600;
      }
      .where {
        color: var(--soft);
      }
      .what {
        margin-top: 0.8mm !important;
      }
      /* Skills và Community xếp chồng, full width: chia 2 cột thì Skills tràn sang trang 2. */
      .cols {
        display: grid;
      }
      .cols p {
        margin: 0;
      }
      /* dòng Skills và Community and Products có divider như Experience, khoảng đệm nhỏ hơn để vừa 1 trang */
      .skill {
        display: grid;
        grid-template-columns: 24mm 1fr;
        gap: 4mm; /* cùng cột với .job */
        padding: 1.3mm 0;
        border-top: 1px solid var(--rule);
      }
      h2 + .skill {
        border-top: 0;
        padding-top: 0;
      }
      .group {
        color: var(--faint);
      }
    </style>
  </head>
  <body>
    <header>
      <div>
        <h1>Ngưu Nguyễn</h1>
        <p class="title">Senior Product Designer</p>
      </div>
      <ul class="contact">
        <li>Nha Trang, Vietnam · open to remote</li>
        <li><a href={email.href}>{email.value}</a> · <a href={phone.href}>{phone.value}</a></li>
        <li><a href={linkedin.href}>linkedin.com/in/{linkedin.value}</a></li>
        <li><a href="https://ontheshore.biz/">ontheshore.biz</a></li>
      </ul>
    </header>

    <p class="summary">
      7 years designing complex B2B products in fintech, banking CRM, enterprise logistics and healthcare. I map the problem space
      before drawing screens, treat the design system as a product, and stay with engineers, PMs, POs and BAs until release. I
      also write front-end code and build design tools.
    </p>

    <h2>Experience</h2>
    {
      experience.map((e) => (
        <div class="job">
          <div class="when num">{e.when}</div>
          <div>
            <p>
              <span class="role">{e.role}</span> <span class="where">· {e.company} ({e.kind.en})</span>
            </p>
            {(e.cv ?? e.what) && <p class="what">{e.cv ?? e.what!.en}</p>}
          </div>
        </div>
      ))
    }

    <div class="cols">
      <div>
        <h2>Skills</h2>
        {
          skills.map((g) => (
            <p class="skill">
              <span class="group">{g.group}</span>
              <span>{g.items.join(" · ")}</span>
            </p>
          ))
        }
      </div>
      <div>
        <h2>Community and Products</h2>
        {
          products.map((it) => (
            <p class="skill">
              <span class="group">{it.name}</span>
              <span>
                {it.what} · <a href={it.href}>{bare(it.href)}</a>
              </span>
            </p>
          ))
        }
      </div>
    </div>
  </body>
</html>
