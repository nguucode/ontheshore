---
import Base from "../layouts/Base.astro";

/* Kiểm kê thật từ Figma Community @nguunguyen73, 19/09/2026.
   Số liệu đọc trực tiếp từ trang profile.
   Thêm mục mới: thêm object vào đúng mảng, không cần sửa gì khác.
   Mục chưa dùng được (chưa có href) hiện nhãn "Đang phát triển", không bấm được, không tính vào số đã publish.
   wip: có trang giới thiệu nhưng chưa dùng được: vẫn bấm được, vẫn hiện nhãn, không tính vào số đã publish. */
type Item = { name: string; href?: string; note?: string; stat?: string; wip?: boolean };

const figmaTemplates: Item[] = [
  {
    name: "Circle Charts",
    href: "https://www.figma.com/community/file/1227645405724568768/circle-charts",
    stat: "72.6k lượt dùng",
    note: "Bộ biểu đồ tròn dựng sẵn cho dashboard.",
  },
  {
    name: "Basic Charts",
    href: "https://www.figma.com/community/file/1295304364849245693/basic-charts",
    stat: "18.7k lượt dùng",
    note: "Biểu đồ nền tảng: cột, đường, vùng.",
  },
  {
    name: "Polaris Chart",
    href: "https://www.figma.com/community/file/1235877373897536001/polaris-chart",
    stat: "12.6k lượt dùng",
    note: "Biểu đồ theo hệ design system Polaris.",
  },
  {
    name: "Country Flags",
    href: "https://www.figma.com/community/file/1360105018474702873/country-flags",
    stat: "104 lượt dùng",
    note: "Bộ cờ quốc gia.",
  },
];

const figmaPlugins: Item[] = [];

const figmaSkills: Item[] = [
  {
    name: "flatten-icon-frames",
    href: "https://www.figma.com/community/skill/89555/flatten-icon-frames",
    note: "Xử lý icon frame hàng loạt: outline stroke, union, fill đen, flatten thành một vector. Chạy được batch 400.",
  },
];

const openSource: Item[] = [
  {
    name: "Blasphemous",
    href: "/products/blasphemous/",
    wip: true,
    note: "Trình chiếu prototype Figma cho khách bằng một link: không cần tài khoản Figma, chuyển phone, tablet, desktop ngay trên trang, iPhone 3D xoay được.",
  },
  {
    name: "Moonveil Icons",
    href: "/moonveilicons/",
    note: "Thư viện icon SVG mã nguồn mở, hai style outline và solid. Dùng qua npm, React, Vue, Web Component, webfont, CDN và CLI. Đang phát triển.",
  },
  {
    name: "Zweihänder",
    href: "/zweihander/",
    note: "UI kit cho React: CSS Modules trên một lớp design token sinh tự động, tài liệu trên Storybook. Giai đoạn đầu, mới có Button và Text Input.",
  },
];

const groups = [
  { heading: "Open source", items: openSource },
  { heading: "Figma — Templates", items: figmaTemplates },
  { heading: "Figma — AI Skills", items: figmaSkills },
  { heading: "Figma — Plugins", items: figmaPlugins },
];

const totalPublished = groups.reduce((n, g) => n + g.items.filter((it) => it.href && !it.wip).length, 0);
---

<Base
  title="Products"
  description="Figma templates, plugins, AI skills and open-source libraries published by Ngưu Nguyễn."
>
  <h1>Products</h1>
  <p class="lede">
    {totalPublished} thứ đã publish, dùng được ngay. Miễn phí.
  </p>

  {
    groups.map((g) => (
      <>
        <h2>{g.heading}</h2>
        {g.items.length === 0 ? (
          <div class="empty">Chưa có gì publish ở mục này.</div>
        ) : (
          <ul class="entries">
            {g.items.map((it) => (
              <li>
                {it.href ? (
                  <a class="entry-title" href={it.href} rel="noopener">
                    {it.name}
                  </a>
                ) : (
                  <span class="entry-title">{it.name}</span>
                )}
                {(!it.href || it.wip) && <div class="entry-meta">Đang phát triển</div>}
                {it.stat && <div class="entry-meta">{it.stat}</div>}
                {it.note && <p class="entry-note">{it.note}</p>}
              </li>
            ))}
          </ul>
        )}
      </>
    ))
  }

  <hr />
  <p class="faint">
    Hồ sơ đầy đủ:{" "}
    <a href="https://www.figma.com/@nguunguyen73" rel="noopener">
      figma.com/@nguunguyen73
    </a>
  </p>
</Base>
